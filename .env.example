# Copy to .env and fill in. .env is git-ignored.

# --- LLM provider: gemini | ollama | fake ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-from-aistudio.google.com
# Verified against ai.google.dev docs (2026-10-10): both have a free tier.
CHAT_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-2
# Changing the model or dimension requires a new migration and a re-ingest.
# 768 is one of the sizes recommended by Google (supported range 128-3072).
EMBED_DIM=768

# --- Ollama (Round 5) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Database ---
POSTGRES_DB=urun_asistani
POSTGRES_USER=urun
POSTGRES_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Search / chat (optional; defaults shown) ---
# Cosine similarity floor (K-8: relevant questions score 0.72+, off-topic at most 0.59).
# Tune with `python manage.py ask --raw "soru"`.
SEARCH_MIN_SCORE=0.63
SEARCH_TOP_K=5
# Chat-call resilience: retries on 429/503/timeout, pause between them, per-request timeout.
CHAT_MAX_RETRIES=2
CHAT_RETRY_WAIT=2
LLM_TIMEOUT_S=30
